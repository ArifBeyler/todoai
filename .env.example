# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets — NOT in Expo .env):
# FAL_KEY=...                    # fal.ai: transcribe-voice (Whisper) + parse-voice-llm (openrouter/router)
# FAL_PARSE_MODEL=google/gemini-2.5-flash-lite   # optional override for parse model on Fal
# ELEVENLABS_API_KEY=...         # optional STT fallback if Fal Whisper fails
# GROQ_API_KEY=...               # optional parse fallback if Fal LLM fails

# RevenueCat (iOS Public SDK Key from RevenueCat Dashboard > API Keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_revenuecat_ios_key
